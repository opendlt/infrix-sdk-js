{
  "targets": {
    "debug": {
      "outFile": "build/debug.wasm",
      "textFile": "build/debug.wat",
      "sourceMap": true,
      "debug": true
    },
    "probe": {
      "outFile": "build/submit-probe.wasm",
      "textFile": "build/submit-probe.wat",
      "optimizeLevel": 0,
      "debug": true
    },
    "governanceProbe": {
      "outFile": "build/governance-probe.wasm",
      "textFile": "build/governance-probe.wat",
      "optimizeLevel": 0,
      "debug": true
    },
    "release": {
      "outFile": "build/release.wasm",
      "textFile": "build/release.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false
    }
  },
  "options": {
    "bindings": "esm",
    "exportRuntime": true,
    "runtime": "stub",
    "use": "abort="
  }
}
